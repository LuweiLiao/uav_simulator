<?xml version="1.0" ?>
<sdf version="1.4">
  <world name="outdoor">

    <scene>
      <ambient>0.65 0.67 0.70 1</ambient>
      <background>0.55 0.78 0.95 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
      <sky>
        <time>12</time>
        <sunrise>6</sunrise>
        <sunset>20</sunset>
        <clouds>
          <speed>0.4</speed>
          <direction>0.6</direction>
          <humidity>0.35</humidity>
          <mean_size>0.5</mean_size>
          <ambient>1 1 1 1</ambient>
        </clouds>
      </sky>
    </scene>

    <!-- Overview of the two transmission towers and the T4 flight area. -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>21 -70 25 0 0.22 1.862253</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>


    <!-- Only one ROS interface plugin is required per world, as any other plugin can connect a Gazebo
         topic to a ROS topic (or vise versa). -->
    <plugin name="ros_interface_plugin" filename="librotors_gazebo_ros_interface_plugin.so"/>

    <physics type="ode">
      <ode>
        <solver>
          <type>quick</type>
          <iters>100</iters>
          <sor>1.0</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>0.1</contact_max_correcting_vel>
          <contact_surface_layer>0.0</contact_surface_layer>
        </constraints>
      </ode>
      <real_time_update_rate>-1</real_time_update_rate> <!--  即模拟时间与实时的比率 -->
    </physics>
    <gravity>0 0 -9.8</gravity>
    
    <include>
      <uri>model://sun</uri>
    </include>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <!-- Preserve the original ground contact geometry and friction. -->
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <contact>
              <collide_bitmask>0xffff</collide_bitmask>
            </contact>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>2000 2000</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>model://grass_plane/materials/scripts/t4_daylight.material</uri>
              <uri>file://media/materials/textures</uri>
              <name>TSD/DaylightGrass</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <model name="tsduav_t4">
      <pose>0 0 0.5 0 0 0</pose>
      <include>
        <uri>model://tsduav_t4</uri>
        <name>tsduav_t4</name>
      </include>
    </model>

    <model name="tsd_electric_tower_instance">
      <pose>0 0 0 0 0 0</pose>
      <include>
        <uri>model://tsd_electric_tower</uri>
        <name>tsd_electric_tower</name>
      </include>
    </model>

    <!-- Disabled during T4 takeoff tuning; re-enable for obstacle/contact tests.
    <model name="tsd_tree_obstacle_instance">
      <pose>5 0 0 0 0 0</pose>
      <include>
        <uri>model://tsd_tree_obstacle</uri>
        <name>tsd_tree_obstacle</name>
      </include>
    </model>

    <model name="balll">
      <static>true</static>
      <pose>10 0 0 0 0 0</pose>
        <link name="balll">
          <pose>0 0 0.0  0 0 0</pose>
          <inertial>
            <pose>0 0 0 0 0 0</pose>
            <mass>300.5</mass>
            <inertia>
              <ixx>10.8133333333333335</ixx>
              <iyy>10.5083333333333334</iyy>
              <izz>10.5083333333333334</izz>
              <ixy>0</ixy>
              <ixz>0</ixz>
              <iyz>0</iyz>
            </inertia>
          </inertial>
          <collision name="balll_collision">
            <pose>0 0 0  0 0 0</pose>
            <geometry>
              <box>
                <size>4 10 5</size>
              </box>
            </geometry>
            <surface>
              <contact>
                <ode/>
              </contact>
              <friction>
                <ode/>
              </friction>
            </surface>
          </collision>
          <visual name="balll_visual">
            <geometry> 
              <box>
                <size>4 10 5</size>
              </box>
            </geometry>
            <material>
              <script>
                <name>Gazebo/Gray</name>
              </script>
            </material>
          </visual>
        </link>
    </model>
    -->


  </world>
</sdf>
