<?xml version="1.0"?>

<model>
  <name>scorpio</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>

  <author>
    <name>Luwei Liao</name>
    <email>liaoluweillw@163.com</email>
  </author>

  <maintainer email="liaoluweillw@163.com">Luwei Liao</maintainer>


  <description>
    Scorpio hexapod with three independently tilting rotors.
    model.rsdf is the editable source; model.sdf is generated from it.
  </description>
  <depend>
    <model>
      <uri>model://scorpio_base</uri>
      <version>1.0</version>
    </model>
    <model>
      <uri>model://scorpio_coxa</uri>
      <version>1.0</version>
    </model>

    <model>
      <uri>model://scorpio_femur</uri>
      <version>1.0</version>
    </model>

    <model>
      <uri>model://scorpio_tibia</uri>
      <version>1.0</version>
    </model>
    
    <model>
      <uri>model://scorpio_tilt</uri>
      <version>1.0</version>
    </model>
    
    <model>
      <uri>model://scorpio_prop</uri>
      <version>1.0</version>
    </model>


  </depend>
</model>
