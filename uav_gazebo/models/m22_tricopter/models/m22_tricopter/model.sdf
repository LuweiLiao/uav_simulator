        </physics>
      </joint>
      <plugin name = "m22_tricopter_tilt_pitch_l_plugin" filename='librotors_gazebo_motor_model.so'>
        <robotNamespace></robotNamespace>
        <jointName>m22_tricopter_tilt_pitch_l_joint</jointName>
        <linkName>m22_tricopter_tilt_pitch_l::tilt</linkName>
        <turningDirection>cw</turningDirection>
        <motorType>position</motorType>
        <commandSubTopic>/gazebo/command/tilt1_pos</commandSubTopic>
        <motorNumber>2</motorNumber>
        <motorSpeedPubTopic>tilt_pos/2</motorSpeedPubTopic>
        <joint_control_pid>
          <p>3</p>
          <i>1.2</i>
          <d>0.8</d>
          <iMax>10</iMax>
          <iMin>-10</iMin>
          <cmdMax>50</cmdMax>
          <cmdMin>-50</cmdMin>
        </joint_control_pid>
      </plugin>
    
      <include>
        <uri>model://m22_tricopter_tilt_roll_l</uri>
        <name>m22_tricopter_tilt_roll_l</name>
        <pose>0 0.36 0.034 0 0 0</pose>
      </include>
      <joint name = "m22_tricopter_tilt_roll_l_joint" type="revolute">
        <parent>m22_tricopter_tilt_pitch_l::tilt</parent>
        <child>m22_tricopter_tilt_roll_l::tilt</child>
        <axis>
          <xyz>1 0 0</xyz>
          <limit>
            <lower>-1.5708</lower>
            <upper>1.5708</upper>
          </limit>
          <dynamics>
            <damping>0.1</damping>
            <spring_stiffness>0</spring_stiffness>
            <spring_reference>0</spring_reference>
          </dynamics>
          <use_parent_model_frame>1</use_parent_model_frame>
        </axis>
        <physics>
          <ode>
            <implicit_spring_damper>1</implicit_spring_damper>
          </ode>
        </physics>
      </joint>
      <plugin name = "m22_tricopter_tilt_roll_l_plugin" filename='librotors_gazebo_motor_model.so'>
        <robotNamespace></robotNamespace>
        <jointName>m22_tricopter_tilt_roll_l_joint</jointName>
        <linkName>m22_tricopter_tilt_roll_l::tilt</linkName>
        <turningDirection>cw</turningDirection>
        <motorType>position</motorType>
        <commandSubTopic>/gazebo/command/tilt1_pos</commandSubTopic>
        <motorNumber>3</motorNumber>
        <motorSpeedPubTopic>tilt_pos/3</motorSpeedPubTopic>
        <joint_control_pid>
          <p>3</p>
          <i>1.2</i>
          <d>0.8</d>
          <iMax>10</iMax>
          <iMin>-10</iMin>
          <cmdMax>50</cmdMax>
          <cmdMin>-50</cmdMin>
        </joint_control_pid>
      </plugin>
    
  
  
  <include>
    <uri>model://m22_tricopter_prop_r_upper</uri>
    <name>m22_tricopter_prop_0</name>
    <pose>0 -0.36 0.106281 0 0 0</pose>
  </include>
  <joint name = "m22_tricopter_prop_0_joint" type="revolute">
    <parent>m22_tricopter_tilt_roll_r::tilt</parent>
    <child>m22_tricopter_prop_0::prop</child>
    <axis>
      <xyz>0 0 1</xyz>
      <limit>
        <lower>-1e+16</lower>
        <upper>1e+16</upper>
      </limit>
      <dynamics>
        <damping>0.0001</damping>
      </dynamics>
      <use_parent_model_frame>1</use_parent_model_frame>
    </axis>
  </joint>
  <plugin name = "prop_0_plugin" filename='librotors_gazebo_motor_model.so'>
    <robotNamespace></robotNamespace>
    <jointName>m22_tricopter_prop_0_joint</jointName>
    <linkName>m22_tricopter_prop_0::prop</linkName>
    <turningDirection>ccw</turningDirection>
    <timeConstantUp>0.0125</timeConstantUp>
    <timeConstantDown>0.025</timeConstantDown>
    <maxRotVelocity>1000</maxRotVelocity>
    <motorConstant>1.199e-05</motorConstant>
    <momentConstant>0.1</momentConstant>
    <commandSubTopic>/gazebo/command/prop_speed</commandSubTopic>
    <motorNumber>0</motorNumber>
    <rotorDragCoefficient>0.000806428</rotorDragCoefficient>
    <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
    <motorSpeedPubTopic>prop_speed/0</motorSpeedPubTopic>
    <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
  </plugin>

  <include>
