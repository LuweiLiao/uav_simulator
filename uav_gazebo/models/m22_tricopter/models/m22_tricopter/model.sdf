<?xml version="1.0" ?>
  
  <sdf version="1.5">
    <model name="m22_tricopter">
      
      <include>
        <uri>model://m22_tricopter_base</uri>
        <name>m22_tricopter_base</name>
        <pose>0 0 0.0 0 0 0</pose>
      </include>
      
      
      <include>
        <uri>model://m22_tricopter_tilt_pitch_r</uri>
        <name>m22_tricopter_tilt_pitch_r</name>
        <pose>0 -0.027 0.034 0 0 0</pose>
      </include>
      <joint name = "m22_tricopter_tilt_pitch_r_joint" type="revolute">
        <parent>m22_tricopter_base::base</parent>
        <child>m22_tricopter_tilt_pitch_r::tilt</child>
        <axis>
          <xyz>0 -1 0</xyz>
          <limit>
            <lower>-1.0e+16</lower>
            <upper>1.0e+16</upper>
          </limit>
          <dynamics>
            <damping>0.1</damping>
            <spring_stiffness>0</spring_stiffness>
            <spring_reference>0</spring_reference>
          </dynamics>
          <use_parent_model_frame>1</use_parent_model_frame>
        </axis>
        <physics>
          <ode>
            <implicit_spring_damper>1</implicit_spring_damper>
          </ode>
        </physics>
      </joint>
      <plugin name = "m22_tricopter_tilt_pitch_r_plugin" filename='librotors_gazebo_motor_model.so'>
        <robotNamespace></robotNamespace>
        <jointName>m22_tricopter_tilt_pitch_r_joint</jointName>
        <linkName>m22_tricopter_tilt_pitch_r::tilt</linkName>
        <turningDirection>cw</turningDirection>
        <motorType>position</motorType>
        <commandSubTopic>/gazebo/command/tilt1_pos</commandSubTopic>
        <motorNumber>0</motorNumber>
        <motorSpeedPubTopic>tilt_pos/0</motorSpeedPubTopic>
        <joint_control_pid>
          <p>3</p>
          <i>1.2</i>
          <d>0.8</d>
          <iMax>10</iMax>
          <iMin>-10</iMin>
          <cmdMax>50</cmdMax>
          <cmdMin>-50</cmdMin>
        </joint_control_pid>
      </plugin>
    
      <include>
        <uri>model://m22_tricopter_tilt_roll_r</uri>
        <name>m22_tricopter_tilt_roll_r</name>
        <pose>0 -0.36 0.034 0 0 0</pose>
      </include>
      <joint name = "m22_tricopter_tilt_roll_r_joint" type="revolute">
        <parent>m22_tricopter_tilt_pitch_r::tilt</parent>
        <child>m22_tricopter_tilt_roll_r::tilt</child>
        <axis>
          <xyz>1 0 0</xyz>
          <limit>
            <lower>-1.5708</lower>
            <upper>1.5708</upper>
          </limit>
          <dynamics>
            <damping>0.1</damping>
            <spring_stiffness>0</spring_stiffness>
            <spring_reference>0</spring_reference>
          </dynamics>
          <use_parent_model_frame>1</use_parent_model_frame>
