<?xml version="1.0"?>

<model>
  <name>m22_tricopter</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>

  <author>
    <name>Luwei Liao</name>
    <email>liaoluweillw@163.com</email>
  </author>

  <maintainer email="liaoluweillw@163.com">Luwei Liao</maintainer>


  <description>
    mk22 tilt tricopter: two front arms with pitch + roll tilt and coaxial props, fixed rear prop
  </description>
  <depend>
    <model>
      <uri>model://m22_tricopter_base</uri>
      <version>1.0</version>
    </model>
    <model>
      <uri>model://m22_tricopter_tilt_pitch_r</uri>
      <version>1.0</version>
    </model>
    <model>
      <uri>model://m22_tricopter_tilt_pitch_l</uri>
      <version>1.0</version>
    </model>
    <model>
      <uri>model://m22_tricopter_tilt_roll_r</uri>
      <version>1.0</version>
    </model>
    <model>
      <uri>model://m22_tricopter_tilt_roll_l</uri>
      <version>1.0</version>
    </model>
    <model>
      <uri>model://m22_tricopter_prop_r_upper</uri>
      <version>1.0</version>
    </model>
    <model>
      <uri>model://m22_tricopter_prop_r_lower</uri>
      <version>1.0</version>
    </model>
    <model>
      <uri>model://m22_tricopter_prop_l_upper</uri>
      <version>1.0</version>
    </model>
    <model>
      <uri>model://m22_tricopter_prop_l_lower</uri>
      <version>1.0</version>
    </model>
    <model>
      <uri>model://m22_tricopter_prop_back</uri>
      <version>1.0</version>
    </model>
  </depend>
</model>
