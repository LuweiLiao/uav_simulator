<?xml version="1.0" ?>
  <%
# mk22：左右两臂各有 pitch（绕 Y）和 roll（绕 X）两级倾转，臂端共轴双桨，后臂固定单桨。
# 坐标：X 机头，Y 左，Z 上；原点在下底板底面中心。所有部件坐标系与机体同向。

tilt_pid_p = 3
tilt_pid_i = 1.2
tilt_pid_d = 0.8

# pitch 关节在 25mm 碳管轴线上，roll 关节在臂端联轴器轴线上
pitch_pos_dy = 0.027
pitch_pos_dz = 0.034
roll_pos_dy  = 0.36

# 舵机编号 0 右 pitch、1 右 roll、2 左 pitch、3 左 roll。约定：前右下机体系，pitch 绕机体 +Y（右）为正，roll 绕机体 +X（机头）为正，左右同号（Gazebo 里 +Y 朝左，所以 pitch 轴写 0 -1 0）
tilt_motors={
	"0" => {:dx => 0, :dy => -pitch_pos_dy, :dz => pitch_pos_dz, :axis => "0 -1 0",  :lower => -1e+16, :upper => 1e+16, :parent => "m22_tricopter_base::base",          :link_name => "m22_tricopter_tilt_pitch_r", :link => "m22_tricopter_tilt_pitch_r"},
	"1" => {:dx => 0, :dy => -roll_pos_dy,  :dz => pitch_pos_dz, :axis => "1 0 0",  :lower => -1.5708, :upper => 1.5708, :parent => "m22_tricopter_tilt_pitch_r::tilt", :link_name => "m22_tricopter_tilt_roll_r",  :link => "m22_tricopter_tilt_roll_r"},
	"2" => {:dx => 0, :dy =>  pitch_pos_dy, :dz => pitch_pos_dz, :axis => "0 -1 0", :lower => -1e+16, :upper => 1e+16, :parent => "m22_tricopter_base::base",          :link_name => "m22_tricopter_tilt_pitch_l", :link => "m22_tricopter_tilt_pitch_l"},
	"3" => {:dx => 0, :dy =>  roll_pos_dy,  :dz => pitch_pos_dz, :axis => "1 0 0", :lower => -1.5708, :upper => 1.5708, :parent => "m22_tricopter_tilt_pitch_l::tilt", :link_name => "m22_tricopter_tilt_roll_l",  :link => "m22_tricopter_tilt_roll_l"},
}

prop_pos_dz_upper = 0.072281
prop_pos_dz_lower = -0.071519

prop_timeConstantUp = 0.0125
prop_timeConstantDown = 0.025
prop_maxRotVelocity = 1000
prop_motorConstant = 1.199e-5
prop_momentConstant = 0.1

prop_back_pos_dx = -0.59
prop_back_pos_dz = 0.087

# 电机编号 0..4。转向是推力反扭矩方向：共轴上下桨反转，左右对称，后桨按零件名 T7056C CCW
prop_motors={
	"0" => {:prop_dx => 0,                :prop_dy => -roll_pos_dy, :prop_dz => pitch_pos_dz + prop_pos_dz_upper, :dir => "ccw", :parent_jont => "m22_tricopter_tilt_roll_r::tilt", :link => "m22_tricopter_prop_r_upper"},
	"1" => {:prop_dx => 0,                :prop_dy => -roll_pos_dy, :prop_dz => pitch_pos_dz + prop_pos_dz_lower, :dir => "cw",  :parent_jont => "m22_tricopter_tilt_roll_r::tilt", :link => "m22_tricopter_prop_r_lower"},
	"2" => {:prop_dx => 0,                :prop_dy =>  roll_pos_dy, :prop_dz => pitch_pos_dz + prop_pos_dz_upper, :dir => "cw",  :parent_jont => "m22_tricopter_tilt_roll_l::tilt", :link => "m22_tricopter_prop_l_upper"},
	"3" => {:prop_dx => 0,                :prop_dy =>  roll_pos_dy, :prop_dz => pitch_pos_dz + prop_pos_dz_lower, :dir => "ccw", :parent_jont => "m22_tricopter_tilt_roll_l::tilt", :link => "m22_tricopter_prop_l_lower"},
	"4" => {:prop_dx => prop_back_pos_dx, :prop_dy => 0,            :prop_dz => prop_back_pos_dz,                 :dir => "ccw", :parent_jont => "m22_tricopter_base::base",        :link => "m22_tricopter_prop_back"},
}

%>
  <sdf version="1.5">
    <model name="m22_tricopter">
      <%# ====================================================================================== %>
      <include>
        <uri>model://m22_tricopter_base</uri>
        <name>m22_tricopter_base</name>
        <pose>0 0 0.0 0 0 0</pose>
      </include>
      <%# ====================================================================================== %>
      <%
			tilt_motors.keys.each do |k|
				dx = tilt_motors[k][:dx]
				dy = tilt_motors[k][:dy]
				dz = tilt_motors[k][:dz]
				axis = tilt_motors[k][:axis]
				parent = tilt_motors[k][:parent]
        link_name = tilt_motors[k][:link_name]
        link = tilt_motors[k][:link]
			%>
      <include>
        <uri><%="model://" + link %></uri>
        <name><%=link_name %></name>
        <pose><%= dx %> <%= dy %> <%= dz %> 0 0 0</pose>
      </include>
      <joint name = <%= '"' + link_name + '_joint"' %> type="revolute">
        <parent><%= parent %></parent>
        <child><%=link_name + '::tilt' %></child>
        <axis>
          <xyz><%= axis %></xyz>
          <limit>
            <lower><%= tilt_motors[k][:lower] %></lower>
            <upper><%= tilt_motors[k][:upper] %></upper>
          </limit>
          <dynamics>
            <damping>0.1</damping>
            <spring_stiffness>0</spring_stiffness>
            <spring_reference>0</spring_reference>
          </dynamics>
          <use_parent_model_frame>1</use_parent_model_frame>
        </axis>
        <physics>
          <ode>
            <implicit_spring_damper>1</implicit_spring_damper>
          </ode>
        </physics>
      </joint>
      <plugin name = <%= '"' + link_name + '_plugin"' %> filename='librotors_gazebo_motor_model.so'>
        <robotNamespace></robotNamespace>
        <jointName><%=link_name + '_joint'%></jointName>
        <linkName><%=link_name + '::tilt' %></linkName>
        <turningDirection>cw</turningDirection>
        <motorType>position</motorType>
        <commandSubTopic>/gazebo/command/tilt1_pos</commandSubTopic>
        <motorNumber><%= k %></motorNumber>
        <motorSpeedPubTopic><%= 'tilt_pos/' + k %></motorSpeedPubTopic>
        <joint_control_pid>
          <p><%= tilt_pid_p %></p>
          <i><%= tilt_pid_i %></i>
          <d><%= tilt_pid_d %></d>
          <iMax>10</iMax>
          <iMin>-10</iMin>
          <cmdMax>50</cmdMax>
          <cmdMin>-50</cmdMin>
        </joint_control_pid>
      </plugin>
    <% end %>
  <%# ====================================================================================== %>
  <%
			prop_motors.keys.each do |k|
				prop_dx = prop_motors[k][:prop_dx]
				prop_dy = prop_motors[k][:prop_dy]
				prop_dz = prop_motors[k][:prop_dz]
				dir = prop_motors[k][:dir]
        parent_jont = prop_motors[k][:parent_jont]
        link = prop_motors[k][:link]
			%>
  <include>
    <uri><%="model://" + link %></uri>
    <name><%="m22_tricopter_prop_" + k %></name>
    <pose><%= prop_dx %> <%= prop_dy %> <%= prop_dz %> 0 0 0</pose>
  </include>
  <joint name = <%='"m22_tricopter_prop_' + k + '_joint"' %> type="revolute">
    <parent><%= parent_jont %></parent>
    <child><%="m22_tricopter_prop_" + k + '::prop' %></child>
    <axis>
      <xyz>0 0 1</xyz>
      <limit>
        <lower>-1e+16</lower>
        <upper>1e+16</upper>
      </limit>
      <dynamics>
        <damping>0.0001</damping>
      </dynamics>
      <use_parent_model_frame>1</use_parent_model_frame>
    </axis>
  </joint>
  <plugin name = <%= '"prop_' + k + '_plugin"' %> filename='librotors_gazebo_motor_model.so'>
    <robotNamespace></robotNamespace>
    <jointName><%="m22_tricopter_prop_" + k + '_joint'%></jointName>
    <linkName><%="m22_tricopter_prop_" + k + '::prop' %></linkName>
    <turningDirection><%= dir %></turningDirection>
    <timeConstantUp><%= prop_timeConstantUp %></timeConstantUp>
    <timeConstantDown><%= prop_timeConstantDown %></timeConstantDown>
    <maxRotVelocity><%= prop_maxRotVelocity %></maxRotVelocity>
    <motorConstant><%= prop_motorConstant %></motorConstant>
    <momentConstant><%= prop_momentConstant %></momentConstant>
    <commandSubTopic>/gazebo/command/prop_speed</commandSubTopic>
    <motorNumber><%= k %></motorNumber>
    <rotorDragCoefficient>0.000806428</rotorDragCoefficient>
    <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
    <motorSpeedPubTopic><%= 'prop_speed/' + k %></motorSpeedPubTopic>
    <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
  </plugin>
<% end %>
<%# ====================================================================================== %>
<plugin name="ArduRotorM22Tricopter" filename="libArduRotorM22Tricopter.so">
  <fdm_addr>127.0.0.1</fdm_addr>
  <fdm_port_in>9002</fdm_port_in>
  <fdm_port_out>9003</fdm_port_out>
  <modelXYZToAirplaneXForwardZDown>0 0 0 3.141593 0 0</modelXYZToAirplaneXForwardZDown>
  <gazeboXYZToNED>0 0 0 3.141593 0 0</gazeboXYZToNED>
  <motor_num>5</motor_num>
  <servo_num>4</servo_num>
  <%# 后桨可正反转：飞控输出 0.5 停转，0 反转满速，1 正转满速 %>
  <reversible_motors>4</reversible_motors>
  <motor_pub>/gazebo/command/prop_speed</motor_pub>
  <servo1_pub>/gazebo/command/tilt1_pos</servo1_pub>
  <imuName>m22_tricopter_base::imu_link::imu_sensor</imuName>
  <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
</plugin>

<plugin name="imu_plugin" filename="librotors_gazebo_imu_plugin.so">
  <robotNamespace>m22_tricopter</robotNamespace>
  <linkName>m22_tricopter_base::imu_link</linkName>
  <imuTopic>imu</imuTopic>
  <gyroscopeNoiseDensity>0.000349</gyroscopeNoiseDensity>     <!-- rad/s/√Hz -->
  <gyroscopeBiasRandomWalk>0.000266</gyroscopeBiasRandomWalk>          <!-- rad/s²/√Hz -->
  <gyroscopeBiasCorrelationTime>600</gyroscopeBiasCorrelationTime> <!-- s -->
  <gyroscopeTurnOnBiasSigma>0.0004</gyroscopeTurnOnBiasSigma>  <!-- rad/s -->
  <accelerometerNoiseDensity>0.00324</accelerometerNoiseDensity> <!-- m/s²/√Hz -->
  <accelerometerRandomWalk>0.0056</accelerometerRandomWalk>     <!-- m/s³/√Hz -->
  <accelerometerBiasCorrelationTime>600</accelerometerBiasCorrelationTime> <!-- s -->
  <accelerometerTurnOnBiasSigma>0.016</accelerometerTurnOnBiasSigma> <!-- m/s² -->
</plugin>


</model>
</sdf>
